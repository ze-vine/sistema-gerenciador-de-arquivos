generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  name          String
  components    Component[]
  files     File[]
  folders   Folder[]
  createdAt     DateTime        @default(now()) @map("created_at")

  @@map("users")
}

enum ComponentType {
  FOLDER
  FILE
}

model Component {
  id              String          @id @default(uuid())
  name            String
  url             String?
  fileType        String?         @map("file_type")
  fileSize        Int?            @map("file_size")
  publicId        String?         @map("public_id")
  componentType   ComponentType   @map("component_type")
  parentType      ComponentType?  @map("parent_type")
  parentId        String?         @map("parent_id")
  userId          String          @map("user_id")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent          Component?      @relation("FolderHierarchy", fields: [parentId, userId, parentType], references: [id, userId, componentType], onDelete: Cascade)
  children        Component[]     @relation("FolderHierarchy")
  createdAt       DateTime        @default(now()) @map("created_at")
  
  @@unique([id, userId, componentType])
  @@map("components")
}

model Folder {
  id            String    @default(uuid())
  name          String    @unique
  files         File[]
  folders       Folder[]  @relation("ChildrenFolders")
  folderId      String?   @map("folder_id")
  folder        Folder?   @relation("ChildrenFolders", fields: [folderId, userId], references: [id, userId]) 
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id])

  @@id(name: "folderUserRelation", [id, userId])
  @@unique([name, folderId])
  @@map("folders")
}

model File {
  id           String   @id @default(uuid())
  name         String
  url          String
  type         String
  size         Int
  publicId     String   @map("public_id")
  folderId     String?  @map("folder_id")
  folder       Folder?  @relation(fields: [folderId, userId], references: [id, userId])
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("files")
}

model TokenBlacklist {
  id            String @id @default(uuid())
  jti           String @unique
  expiresAt     DateTime @map("expires_at")

  @@map("token_blacklist")
  @@index([jti])
}